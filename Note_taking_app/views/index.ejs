<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 flex flex-col">
        <div class="form w-full p-6">
            <form action="/create" method="POST" class="flex flex-col gap-4">
                <input type="text" name="title" class="block w-full px-4 py-3 text-white bg-zinc-800 border border-zinc-700 rounded-md placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" placeholder="Title goes here.." required>

                <textarea name="details" class="block w-full px-4 py-3 text-white bg-zinc-800 border border-zinc-700 rounded-md placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition resize-none h-28" placeholder="Write your task details here..." required></textarea>

                <input type="submit" value="Create Task" class="w-fit px-5 py-2 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-medium rounded-md cursor-pointer transition-all duration-150">
            </form>
        </div>
        <div class="tasks p-10 gap-4 flex flex-wrap justify-start">
            <% if (files && files.length > 0) { %>
                <% files.forEach(function(file) { %>
                    <div class="task w-52 px-4 py-5 rounded-md bg-zinc-800">
                        <h1 class="text-white text-xl font-bold mb-3"><%= file.replace('.txt', '') %></h1>
                        <div class="flex w-full justify-between items-center mt-3">
                            <a class="text-blue-500 text-sm hover:text-blue-400 transition" href="/read/<%= file %>">Read More →</a>
                            <a class="text-zinc-400 text-sm hover:text-zinc-300 transition" href="/edit/<%= file %>">Edit</a>  <!-- ✅ fixed: file instead of val, fixed closing tag -->
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-zinc-500 text-center w-full py-10">
                    No tasks created yet. Create your first task above!
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>